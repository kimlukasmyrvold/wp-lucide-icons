{
    "name": "wp-icons",
    "description": "Adds icon elements to place on pages, uses icons from Lucide Icons, Material Icons and other various icon libraries. Integrates with some WordPress themes like Flatsome.",
    "version": "2.0.0",
    "author": "Kim Lukas Myrvold",
    "keywords": [
        "wordpress plugin",
        "lucide icons",
        "material icons"
    ],
    "license": "GPLv2 or later",
    "browserslist": [
        "> 1%",
        "last 2 versions",
        "not dead"
    ],
    "homepage": "https://github.com/kimlukasmyrvold/wp-lucide-icons#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kimlukasmyrvold/wp-lucide-icons.git"
    },
    "bugs": {
        "url": "https://github.com/kimlukasmyrvold/wp-lucide-icons/issues"
    },
    "scripts": {
        "sass": "node node_modules/sass/sass.js -w src/assets/scss:src/assets/css --style compressed --no-source-map",
        "sass:build": "node node_modules/sass/sass.js src/assets/scss:src/assets/css --style compressed --no-source-map",
        "build": "node node_modules/@wordpress/scripts/bin/wp-scripts.js build",
        "start": "node node_modules/@wordpress/scripts/bin/wp-scripts.js start",
        "publish": "node publish.js wp-lucide-icons.php",
        "sync-icons": "node scripts/sync-icons.js",
        "sync-icons:lucide": "node scripts/sync-lucide-icons.js",
        "sync-icons:material": "node scripts/sync-material-symbols.js"
    },
    "dependencies": {
        "archiver": "^7.0.1",
        "fs-extra": "^11.3.0",
        "sass": "^1.83.0"
    },
    "devDependencies": {
        "@wordpress/scripts": "^30.25.0",
        "tar": "^7.5.22"
    }
}
