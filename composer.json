{
  "name": "kimlukasmyrvold/wp-lucide-icons",
  "description": "Adds Lucide icons support to WordPress using shortcodes.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "autoload": {
    "psr-4": {
      "WpLucideIcons\\": "src/includes/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
